# Shared
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# API only. This must be the anon key, never the service_role key.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=replace-with-local-anon-key
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
# Compose supplies Redis. Local uvicorn may use the in-process development limiter.
# REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_WRITES_PER_MINUTE=30
# Required (32+ characters each) for staging/production. Never NEXT_PUBLIC_*.
METRICS_TOKEN=
LOG_HASH_KEY=local-development-only
# Optional error tracker; configure a project and alerts before deployment.
# SENTRY_DSN=https://public-key@your-sentry-host/project
