{
  "name": "multi-tenant-saas-starter",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "test:api": "uv run --directory apps/api pytest tests/unit",
    "test:api:integration": "./scripts/test-api-integration.sh",
    "test:web": "pnpm --dir apps/web run test",
    "lint:web": "pnpm --dir apps/web lint",
    "lint:api": "uv run --directory apps/api ruff check app tests",
    "test:e2e": "python3 scripts/local.py e2e",
    "setup:local": "python3 scripts/local.py env"
  },
  "devDependencies": {
    "supabase": "^2.117.0"
  }
}
